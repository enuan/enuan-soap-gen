# Code generated by enuan-soap-gen; DO NOT EDIT.

SOAPGEN ?= go run github.com/enuan/enuan-soap-gen/cmd/enuan-soap-gen@latest
SOAPGEN_CONFIG ?= soapgen.yaml
BINARY ?= {{ .Config.Gateway }}
BIN_DIR ?= bin

.PHONY: gen gen-client verify build

gen:
	$(SOAPGEN) gen --config $(SOAPGEN_CONFIG)

gen-client:
	$(SOAPGEN) gen --config $(SOAPGEN_CONFIG) --client-only

verify:
	go build ./...
	go vet ./...
	go test ./...

# Static build: no cgo is involved, so the binary runs on hosts with an older
# glibc than the build machine (older Debian/Ubuntu hosts).
build:
	CGO_ENABLED=0 go build -trimpath -o $(BIN_DIR)/$(BINARY) ./{{ .Config.CmdDir }}
