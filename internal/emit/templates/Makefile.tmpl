# Code generated by enuan-soap-gen; DO NOT EDIT.

SOAPGEN ?= go run github.com/enuan/enuan-soap-gen/cmd/enuan-soap-gen@latest
SOAPGEN_CONFIG ?= soapgen.yaml

# Version stamped into the binary via m3-go/core ldflags; override to reproduce
# a build. Empty git info (e.g. no checkout) leaves core's "unknown".
GIT_HASH ?= $(shell git rev-parse --verify HEAD 2>/dev/null)
COMMIT_TIME ?= $(shell git show -s --format=%ci HEAD 2>/dev/null)
LDFLAGS ?= -X 'github.com/enuan/m3-go/core.buildHash=$(GIT_HASH)' \
           -X 'github.com/enuan/m3-go/core.buildTime=$(COMMIT_TIME)'

.PHONY: gen gen-client verify install

gen:
	$(SOAPGEN) gen --config $(SOAPGEN_CONFIG)

gen-client:
	$(SOAPGEN) gen --config $(SOAPGEN_CONFIG) --client-only

verify:
	go build ./...
	go vet ./...
	go test ./...

# Static install into $(go env GOBIN) or $(go env GOPATH)/bin.
# The version (commit hash and commit time) is stamped with ldflags, so the
# startup log and -version report the build; CGO_ENABLED=0 keeps the binary
# independent from the build machine's glibc (older Debian/Ubuntu hosts).
install:
	CGO_ENABLED=0 go install -trimpath -ldflags "$(LDFLAGS)" ./{{ .Config.CmdDir }}
