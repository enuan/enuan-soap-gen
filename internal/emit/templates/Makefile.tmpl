# Code generated by enuan-soap-gen; DO NOT EDIT.

SOAPGEN ?= go run github.com/enuan/enuan-soap-gen/cmd/enuan-soap-gen@latest
SOAPGEN_CONFIG ?= soapgen.yaml

.PHONY: gen gen-client verify install

gen:
	$(SOAPGEN) gen --config $(SOAPGEN_CONFIG)

gen-client:
	$(SOAPGEN) gen --config $(SOAPGEN_CONFIG) --client-only

verify:
	go build ./...
	go vet ./...
	go test ./...

# Static install into $(go env GOBIN) or $(go env GOPATH)/bin: CGO_ENABLED=0
# keeps the binary independent from the build machine's glibc, so it also runs
# on hosts with an older one (older Debian/Ubuntu).
install:
	CGO_ENABLED=0 go install -trimpath ./{{ .Config.CmdDir }}
